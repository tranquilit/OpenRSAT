msgid "Primary zone"
msgstr "Πρωτεύουσα ζώνη"

#: tvisnewzonewizard.radiobutton2.caption
msgid "Secondary zone"
msgstr "Δευτερεύουσα ζώνη"

#: tvisnewzonewizard.radiobutton3.caption
msgid "Stub zone"
msgstr "Stub ζώνη"

